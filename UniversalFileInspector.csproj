<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Ufi</RootNamespace>
    <AssemblyName>UniversalFileInspector</AssemblyName>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <Product>Universal File Inspector</Product>
    <Description>Read-only, terminal-style inspector for any file.</Description>
    <Copyright>MIT License</Copyright>
    <NoWarn>$(NoWarn);CA1416;SYSLIB0057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
